public class Solution {
    public long MaximumScore(int[] nums, string s) {
        var pq = new PriorityQueue<int,int>();
        long ans =  0;
        int idx = 0;
        for( int i = 0 ; i < s.Length ; i++)
        {
            pq.Enqueue(nums[i],-nums[i]);
            if( s[i] == '1' ) 
            {
                int addition = pq.Peek();
                pq.Dequeue();
                ans += addition;
            }
        }
        return ans;
    }
}
