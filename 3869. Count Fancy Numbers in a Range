public class Solution {
    // Flattened 4D DP table to store valid suffix counts.
    // Size = 16 (lengths) * 10 (last digits) * 4 (trends) * 150 (sums) = 96000
    static long[] dp = new long[96000];
    
    // ok[i] stores whether the sum 'i' is a "good" number (strictly monotone digits)
    static bool[] ok = new bool[150];
    static bool init = false;

    static void Init() {
        if (init) return; // Only precompute once globally
        
        // 1. Precompute valid sums. Max possible sum is 15 * 9 = 135.
        for (int i = 1; i <= 149; i++) {
            if (i < 10) ok[i] = true; // 1-9 are strictly monotone
            else if (i < 100) ok[i] = (i / 10) != (i % 10); // Two digits: must not be equal
            else {
                // Three digits (e.g., 123 or 321)
                int a = i / 100, b = (i / 10) % 10, c = i % 10;
                ok[i] = (a < b && b < c) || (a > b && b > c);
            }
        }
        
        // 2. Base case for DP: 0 digits left to place (rem_len = 0).
        for (int l = 0; l <= 9; l++) {           // last digit
            for (int t = 0; t <= 3; t++) {       // trend
                for (int s = 0; s <= 149; s++) { // accumulated sum
                    // A number is fancy if its digits are good (trend 0, 1, or 2) 
                    // OR if its sum is good (ok[s] is true).
                    if (t != 3 || ok[s]) {
                        dp[l * 600 + t * 150 + s] = 1;
                    }
                }
            }
        }
        
        // 3. Bottom-up DP to fill remaining lengths from 1 to 15
        for (int r = 1; r <= 15; r++) {
            int ro = r * 6000, pro = (r - 1) * 6000; // ro = current length offset, pro = prev length offset
            for (int l = 0; l <= 9; l++) {
                int lo = l * 600;
                for (int t = 0; t <= 3; t++) {
                    int to = t * 150;
                    // Max sum at length r is roughly r * 9, but bounded by 140 for safety
                    for (int s = 0; s <= 140; s++) {
                        long sum = 0;
                        // Try appending every possible next digit 'd'
                        for (int d = 0; d <= 9; d++) {
                            int nt = t; // next trend
                            
                            // Determine the new trend based on the last digit 'l' and new digit 'd'
                            if (t == 0) { // Undecided
                                if (d > l) nt = 1;      // became increasing
                                else if (d < l) nt = 2; // became decreasing
                                else nt = 3;            // became broken (equal digits)
                            } else if (t == 1) { // Increasing
                                if (d <= l) nt = 3;     // broken if not strictly greater
                            } else if (t == 2) { // Decreasing
                                if (d >= l) nt = 3;     // broken if not strictly less
                            }
                            
                            // Add the valid suffixes from the state with (r-1) remaining digits
                            sum += dp[pro + d * 600 + nt * 150 + s + d];
                        }
                        // Save the computed sum to the current DP state
                        dp[ro + lo + to + s] = sum;
                    }
                }
            }
        }
        
        init = true;
    }

    public long CountFancy(long l, long r) {
        Init();
        // Standard prefix difference: [l, r] = Count(r) - Count(l - 1)
        return Solve(r) - Solve(l - 1);
    }
    
    // Counts all fancy numbers in the range [1, n]
    long Solve(long n) {
        if (n == 0) return 0;
        
        // Extract digits of n into array 'd' (least significant first)
        int[] d = new int[20];
        int len = 0;
        while (n > 0) {
            d[len++] = (int)(n % 10);
            n /= 10;
        }
        
        long ans = 0;
        
        // Step 1: Add all fancy numbers with strictly fewer digits than n.
        for (int i = 1; i < len; i++) {
            int ro = (i - 1) * 6000;
            for (int v = 1; v <= 9; v++) { // Numbers cannot start with 0
                ans += dp[ro + v * 600 + v];
            }
        }
        
        // Step 2: Add valid numbers with exactly the same length as n, 
        // but smaller in magnitude.
        int t = 0, s = 0, last = 0; // Running state of the prefix matching 'n'
        
        for (int i = len - 1; i >= 0; i--) {
            int lim = d[i]; // Current digit of n
            int st = (i == len - 1) ? 1 : 0; // First digit cannot be 0
            int ro = i * 6000;
            
            // Try all valid digits strictly less than the current digit of n
            for (int v = st; v < lim; v++) {
                if (i == len - 1) {
                    // For the very first digit, the trend is 0 and sum is just 'v'
                    ans += dp[ro + v * 600 + v];
                } else {
                    int nt = t;
                    // Calculate next trend
                    if (t == 0) {
                        if (v > last) nt = 1;
                        else if (v < last) nt = 2;
                        else nt = 3;
                    } else if (t == 1) {
                        if (v <= last) nt = 3;
                    } else if (t == 2) {
                        if (v >= last) nt = 3;
                    }
                    // Add valid configurations for this branch
                    ans += dp[ro + v * 600 + nt * 150 + s + v];
                }
            }
            
            // Step 3: Update the running state to match the exact prefix of n
            if (i == len - 1) {
                t = 0; // First digit placed, trend is undecided
            } else {
                if (t == 0) {
                    if (lim > last) t = 1;
                    else if (lim < last) t = 2;
                    else t = 3;
                } else if (t == 1) {
                    if (lim <= last) t = 3;
                } else if (t == 2) {
                    if (lim >= last) t = 3;
                }
            }
            s += lim;
            last = lim;
        }
        
        // Step 4: Finally, check if 'n' itself completely satisfies the fancy condition.
        if (t != 3 || ok[s]) ans++;
        
        return ans;
    }
}
