public class Solution {
    public int MinAllOneMultiple(int k) {
        if (k % 2 == 0 || k % 5 == 0)
            return -1;

        if (k == 1)
            return 1;

        for (int rem = 1, result = 2;; ++result) 
            if ((rem = (rem * 10 + 1) % k) == 0)
                return result;
    }
}
