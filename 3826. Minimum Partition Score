public class Solution {
    public long MinPartitionScore(int[] nums, int k) {
        int n = nums.Length;
        long[] prefix = new long[n + 1];

        for (int i = 0; i < n; i++)
            prefix[i + 1] = prefix[i] + nums[i];

        long[] prev = new long[n + 1];
        long[] curr = new long[n + 1];
        long inf = long.MaxValue / 2;

        Array.Fill(prev, inf);
        prev[0] = 0;

        for (int parts = 1; parts <= k; parts++) {
            Array.Fill(curr, inf);

            for (int i = parts; i <= n; i++) {
                for (int j = parts - 1; j < i; j++) {
                    if (prev[j] == inf)
                        continue;

                    long sum = prefix[i] - prefix[j];
                    long cost = sum * (sum + 1) / 2;
                    curr[i] = Math.Min(curr[i], prev[j] + cost);
                }
            }

            (prev, curr) = (curr, prev);
        }

        return prev[n];
    }
}
